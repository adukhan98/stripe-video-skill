  "motion": {
    "feel": "soft, tactile, editorial; things float, settle and stack",
    "pop": "back.out(1.4)",
    "entrance": "0.35-0.6 s"
  },
  "voice": "Plain-spoken creator, direct to camera.",
  "imagery": "Soft tactile 3D-ish objects on grey paper: coins, cards, pills, dotted paths, agent puck. Real pages in browser cards. Speaker in a tilted floating video card.",
  "rules": {
    "do": [
      "Accent only on 1-2 key words per phrase",
      "Soft shadows, no outlines"
    ],
    "dont": [
      "Hard outlines or offset shadows",
      "Draw or imitate the Claude logo",
      "More than one accent colour"
    ]
  }
